{
  // ---------------------------------------------------------------------------
  // Pages-project "pin" — de landingspagina's plus de PIN API-proxy.
  //
  // LET OP: dit is een Pages-project, geen Worker. Het draait op
  // pin-e5x.pages.dev en play-center.org en bouwt automatisch bij een push naar
  // GitHub. De API zit daarom in functions/, niet in een los Worker-bestand.
  //
  // Controleer in het dashboard dat de build output directory op "/" staat
  // voordat je dit samenvoegt; die moet overeenkomen met
  // pages_build_output_dir hieronder.
  // ---------------------------------------------------------------------------
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pin",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-08-16",

  // Gewone variabelen. Het API Key hoort hier NIET: dat is een secret en gaat
  // met een apart commando naar het Pages-project:
  //
  //   npx wrangler pages secret put MOBPLUS_TOKEN --project-name pin
  //
  "vars": {
    // Publisher-ID bij Mobplus. Niet geheim.
    "AFF_ID": "4647",

    // Alleen nodig voor landingspagina's op een ander domein. Pagina's in deze
    // repo staan op hetzelfde domein en hebben geen CORS nodig.
    "ALLOWED_ORIGINS": "https://play-center.org",

    // "1" = nummer moet met een mobiel prefix uit GEOS beginnen. Zet op "0"
    // zodra een carrier prefixen blijkt te gebruiken die daar niet in staan.
    "STRICT_PREFIX": "1"
  }

  // Snelheidslimiet: koppel een KV-namespace en de limiet gaat aan. Zonder deze
  // binding draait alles, maar ongelimiteerd.
  //
  //   npx wrangler kv namespace create PIN_KV
  //
  // ,"kv_namespaces": [
  //   { "binding": "PIN_KV", "id": "VUL_DE_KV_ID_IN" }
  // ]
}
